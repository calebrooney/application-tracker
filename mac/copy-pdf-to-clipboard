#!/bin/bash
# macOS Print → PDF menu item ("Copy PDF to Clipboard").
# PDF Services pass: $1=title, $2=print settings, $3=temp PDF path.
# Copies PDF bytes to the clipboard, then deletes the temp file.
set -euo pipefail

LOG="/tmp/job-tracker-pdf-service.log"
{
  echo "---- $(date) ----"
  echo "args: $*"
} >>"$LOG" 2>&1 || true

# Prefer $3 (standard PDF Service layout); else any arg that is an existing file.
PDF=""
for arg in "${3:-}" "${2:-}" "${1:-}" "$@"; do
  if [ -n "$arg" ] && [ -f "$arg" ]; then
    PDF="$arg"
    break
  fi
done

if [ -z "$PDF" ]; then
  echo "no pdf arg" >>"$LOG" 2>&1 || true
  osascript -e 'display notification "No PDF received from Print." with title "Copy PDF to Clipboard"' 2>/dev/null || true
  exit 1
fi

echo "pdf=$PDF" >>"$LOG" 2>&1 || true

# Classic AppleScript clipboard (JXA NSPasteboard bridging is unreliable here).
osascript -e "set the clipboard to (read (POSIX file \"$PDF\") as «class PDF »)" >>"$LOG" 2>&1

rm -f "$PDF"
echo "ok" >>"$LOG" 2>&1 || true

osascript -e 'display notification "PDF is on the clipboard — run applied and press Enter." with title "Copy PDF to Clipboard"' 2>/dev/null || true
